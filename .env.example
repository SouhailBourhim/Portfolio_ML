# Portfolio ML — environment template
#
# Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored (.gitignore:59) and must never be committed.
# This file is the committed template and must never contain a real key.
#
# Who reads `.env`:
#   - `src/ingest.py:38` and `src/pipeline.py:21` call `load_dotenv(ROOT / ".env")`,
#     so anything below is visible to the ingestion and pipeline entry points.
#   - `compose.yaml:103-105` declares `env_file: .env` with `required: true`, so
#     `docker compose run --rm pipeline` fails outright if the file is absent.
#
# What does NOT read `.env`: the `dvc` CLI. See the DVC section at the bottom.


# ─────────────────────────────────────────────────────────────────────────────
# FRED — macro features (REQUIRED for ingestion)
# ─────────────────────────────────────────────────────────────────────────────
# Consumed by src/ingest.py:197, which raises EnvironmentError when unset.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Bank Al-Maghrib — official MAD/USD rate (REQUIRED for the FX backfill)
# ─────────────────────────────────────────────────────────────────────────────
# Consumed by src/bam_fx.py:118 (constant BAM_API_KEY, defined at :77) and sent
# as the `Ocp-Apim-Subscription-Key` header. Needed by scripts/backfill_bam_fx.py
# and any rebuild of the MAD conversion underpinning the `full_2021` universe.
#
# Key: https://apihelpdesk.centralbankofmorocco.ma
#      Account details → Subscriptions → "Marché des changes" → primary key
BAM_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# MLflow — experiment tracking (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────
# src/utils.py:81 falls back to a local SQLite store (`sqlite:///mlflow.db`)
# when unset, so leaving this blank is a supported configuration.
MLFLOW_TRACKING_URI=


# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 / DVC — artifact bundle
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ Putting these in `.env` alone is NOT enough. The `dvc` CLI is a separate
#   process that never imports `src/`, so `load_dotenv` never runs for it. DVC
#   resolves credentials through boto3's default chain, which reads the real
#   process environment. Export them into your shell before pulling:
#
#     PowerShell (Windows):
#       $env:AWS_ACCESS_KEY_ID = "..."
#       $env:AWS_SECRET_ACCESS_KEY = "..."
#       .\scripts\dvc.ps1 pull
#
#     bash/zsh:
#       export AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=...
#       ./scripts/dvc.sh pull
#
#   Use the wrappers rather than calling dvc directly: both put the project venv
#   on PATH, which DVC needs because it runs the dvc.yaml stage commands through
#   a shell where bare `python` would otherwise resolve to the system
#   interpreter. scripts/dvc.sh detects either venv layout; scripts/dvc.ps1 is
#   its PowerShell twin for Windows without Git Bash. See docs/WINDOWS_SETUP.md.
#
# Do NOT run `dvc remote modify --local` to store these. That writes
# `.dvc/config.local`, which CI explicitly asserts is absent
# (.github/workflows/ci.yml:179-184) — credentials are env-vars-only by design.
#
# The non-secret half of the config is already committed in `.dvc/config`:
# bucket `s3://portfolio-ml-data`, `region = auto`, and the R2 endpoint URL.
#
# Token: Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API token.
# "Object Read only" is sufficient for `dvc pull`.
# CI holds the same pair as the repo secrets R2_ACCESS_KEY_ID /
# R2_SECRET_ACCESS_KEY, mapped onto these AWS names (ci.yml:162-163).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
