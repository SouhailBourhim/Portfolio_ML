# Secrets — never in the image
.env
# DVC remote credentials (R2 access key + secret). Git never sees this file
# because .dvc/.gitignore excludes it, but Docker COPY reads the filesystem,
# not the index — so gitignoring a secret does NOT keep it out of an image.
.dvc/config.local

# Virtualenv, caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Data and run artifacts — generated at runtime or mounted as volumes
data/
mlruns/
mlflow.db
*.db
.dvc/cache/
.dagster_home/
.tmp_dagster_home_*/

# VCS and local tooling
.git/
.claude/
CLAUDE.md
CLAUDE.v2.md

# Docs not needed inside the container
docs/*.docx
