# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── DVC ──────────────────────────────────────────────────────────────────────
/data/bronze/
/data/silver/
/data/gold/
# Synthetic output of the `smoke` CI wiring target — a DVC out, and not a
# result: it must never be committed or mistaken for an evaluation artifact.
/data/smoke/
*.dvc
# the DVC config directory itself IS tracked (its own .gitignore excludes the cache)
!.dvc

# ── MLflow ───────────────────────────────────────────────────────────────────
mlruns/
mlflow/mlflow.db
mlflow/artifacts/

# ── Dagster ──────────────────────────────────────────────────────────────────
.dagster_home/
.tmp_dagster_home_*/
dagster.yaml

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment variables ────────────────────────────────────────────────────
.env
*.env.local

# ── Claude Code ──────────────────────────────────────────────────────────────
CLAUDE.md
CLAUDE.v2.md
.claude/

# ── Misc generated files ─────────────────────────────────────────────────────
mlflow.db
.pytest_cache/
anaconda_projects/
*.db

# Microsoft Office lock/temp files (created when a .docx deliverable is open)
~$*

# LaTeX build artefacts (le PDF, lui, est versionné)
docs/rapport/main.log
docs/rapport/*.aux
docs/rapport/*.toc
docs/rapport/*.out
docs/rapport/*.lof
docs/rapport/*.lot
